# Kopieer naar .env en vul in. .env staat in .gitignore — committen verboden.

# ---- Verplicht ----
# API-key voor OpenRouter (alle agents praten via OpenRouter met de modellen).
OPENROUTER_API_KEY=sk-or-...

# ---- Optioneel ----
# Firecrawl, enkel nodig als je taken scraping-context laat ophalen (consultant_scraper).
# FIRECRAWL_API_KEY=fc-...

# Pad naar de lokale memory-database (projectgeschiedenis, lessen, poorten).
# Standaard: ./data/factory.db — gewoon laten staan is prima.
# MEMORY_DB=./data/factory.db

# ---- Database (alleen voor gegenereerde services die er een nodig hebben) ----
# Standaard uit. Zet op true én start de lokale Postgres (docker compose up -d postgres)
# enkel wanneer een gegenereerde service een database vereist.
DATABASE_ENABLED=false
# Bij gebruik van de lokale Postgres uit docker-compose.yml:
# DATABASE_URL=postgresql://factory_admin:factory_local@localhost:5432/factory_main
