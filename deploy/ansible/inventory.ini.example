# Kopieer naar inventory.ini en vul het IP van je VM in.
# Het IP krijg je uit `terraform output` (Proxmox of Azure) of uit je hypervisor.

[ai_factory]
my-vm ansible_host=192.0.2.10

[ai_factory:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_python_interpreter=/usr/bin/python3
