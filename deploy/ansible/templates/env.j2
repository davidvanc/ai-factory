# Door Ansible gegenereerd. Bewerk op de VM indien nodig.
OPENROUTER_API_KEY={{ openrouter_api_key }}
{% if firecrawl_api_key | length > 0 %}
FIRECRAWL_API_KEY={{ firecrawl_api_key }}
{% endif %}

# Lokale memory-database (default is prima).
MEMORY_DB=./data/factory.db

# Database staat uit; zet aan + start lokale Postgres alleen wanneer een
# gegenereerde service er een nodig heeft (zie docker-compose.yml).
DATABASE_ENABLED=false
# DATABASE_URL=postgresql://factory_admin:factory_local@localhost:5432/factory_main
